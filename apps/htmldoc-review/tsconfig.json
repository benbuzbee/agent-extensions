{
  // Modern Cloudflare Workers tsconfig. Runtime types come from the file
  // generated by `wrangler types` (npm run cf-typegen) -> worker-configuration.d.ts,
  // referenced in compilerOptions.types, which SUPERSEDES @cloudflare/workers-types.
  // Source verified 2026-06-29:
  //   https://developers.cloudflare.com/workers/languages/typescript/#generate-types
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],

    // Generated runtime types (KVNamespace, ExecutionContext, ExportedHandler, ...).
    // Regenerate with `npm run cf-typegen` after editing wrangler.toml. The
    // `cloudflare:test` module types are pulled in per-file via a triple-slash
    // /// <reference types="@cloudflare/vitest-pool-workers/types" /> in the
    // worker test, so they don't leak into src/.
    "types": ["./worker-configuration.d.ts"],

    // Each file compiles in isolation (matches the esbuild bundler Workers uses)
    // and type-only imports must be written `import type` -- catches accidental
    // value imports of types at author time.
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Shared comment sources live in the htmldocs skill — the single editable
    // copy. Wrangler forwards this tsconfig (and its paths) to esbuild, so the
    // alias resolves identically for typecheck, `wrangler dev`, and deploy;
    // the worker vitest config mirrors it as a Vite resolve.alias.
    "paths": {
      "@shared/*": ["../../plugins/useful-skills/skills/htmldocs/src/comments/*"]
    }
  },
  "include": ["src", "test"]
}
